# Copiar a .env en el SERVIDOR (cp .env.example .env) y completar. Nunca subir .env a GitHub.

# Kaggle: https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# Jenkins
JENKINS_ADMIN_PASSWORD=
JENKINS_URL=http://IP-O-DOMINIO:8081/
JENKINS_PORT=8081
# Repositorio a desplegar y token de GitHub (fine-grained, solo lectura de "Contents")
REPO_URL=https://github.com/Julianlc324/lifemap.git
GITHUB_USER=Julianlc324
GITHUB_TOKEN=
# Si Jenkins no es alcanzable desde internet: pollSCM cada 2 minutos (aceptado por la guía)
POLL_SCM_SPEC=H/2 * * * *

# API pública
API_PORT=5000

# Opción B (equipo de laboratorio): túnel ngrok con dominio fijo gratuito
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Recursos (ajustar al servidor; con 16 GB de RAM sirven estos valores)
SPARK_WORKER_CORES=3
SPARK_WORKER_MEMORY=3g
DASK_WORKER_MEMORY=2.5GB

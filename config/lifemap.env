# Configuración NO secreta del proyecto (sí va al repositorio).
# Los secretos (Kaggle, GitHub, ngrok, clave de Jenkins) van en .env, que está en .gitignore.

# ---- Alcance del equipo: reportarlo al docente, no se repite entre equipos ----
METRO_NAME=Philadelphia
# lat_min,lat_max,lon_min,lon_max (ver otras áreas en docs/areas.md)
METRO_BBOX=39.70,40.30,-75.60,-74.90
CATEGORY_FAMILY=Restaurants

# ---- Datos ----
# 0 = todas las reseñas del área; o un tope >= 1000000 si el servidor no alcanza
MAX_REVIEWS=0
GEOHASH_PRECISION=5

# ---- Definiciones analíticas (justificadas en docs/decisiones.md) ----
CUTOFF_T=2020-06-30
OBS_START=2010-01-01
MIN_BUSINESS_DAYS=18250
KM_MIN_N=30
KM_MIN_EVENTS=10

# ---- Streaming ----
WINDOW_DURATION=30 days
WATERMARK_DELAY=7 days
HOTSPOT_DELTA_PP=10
HOTSPOT_MIN_REVIEWS=15
COMPETITOR_RADIUS_M=500
SPARK_STREAM_CORES=2
SPARK_BATCH_CORES=4

# ---- Servicios (nombres de la red de Compose) ----
MONGO_URI=mongodb://mongo:27017
MONGO_DB=lifemap
SPARK_MASTER=spark://spark-master:7077
SPARK_MASTER_UI=http://spark-master:8080
DASK_SCHEDULER=tcp://dask-scheduler:8786
DASK_DASHBOARD=http://dask-scheduler:8787
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=reviews
KAFKA_PARTITIONS=3
DATA_DIR=/data
MODELS_DIR=/models
